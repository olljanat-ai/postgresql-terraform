# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

subscription_id = "00000000-0000-0000-0000-000000000000"
server_name     = "psql-prototype-0001"

# Public address Terraform runs from: curl -s https://api.ipify.org
client_ip_address = "203.0.113.10"

# az ad signed-in-user show --query id -o tsv
entra_administrator_object_id = "11111111-1111-1111-1111-111111111111"
# az ad signed-in-user show --query userPrincipalName -o tsv
entra_administrator_principal_name = "you@example.com"

# az ad group show --group sg-analytics-db-owners --query id -o tsv
analytics_group_name      = "sg-analytics-db-owners"
analytics_group_object_id = "22222222-2222-2222-2222-222222222222"

# az identity show --name id-reporting --resource-group rg-reporting --query principalId -o tsv
reporting_identity_name      = "id-reporting"
reporting_identity_object_id = "33333333-3333-3333-3333-333333333333"

# Better passed as TF_VAR_administrator_password so it stays out of the file.
# administrator_password = "..."
